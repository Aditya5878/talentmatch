# LLM Provider (Groq via LiteLLM)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
LLM_MODEL=groq/llama-3.3-70b-versatile

# Search (Tavily)
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxx

# Embedding (local sentence-transformers, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=100

# MongoDB
# Local:    mongodb://localhost:27017/talentmatch
# Atlas:    mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/talentmatch?retryWrites=true&w=majority
# Docker:   mongodb://mongo:27017/talentmatch
MONGODB_URI=mongodb://localhost:27017/talentmatch

# Qdrant mode: "local" (in-process, no server) or "remote" (Docker/server)
# Switching to Docker? Set QDRANT_MODE=remote and MONGODB_URI=mongodb://mongo:27017/talentmatch
QDRANT_MODE=local
QDRANT_URL=http://localhost:6333

# Qdrant collection names
QDRANT_COLLECTION_CANDIDATE=candidate_chunks
QDRANT_COLLECTION_JD=jd_chunks

# Server
HOST=0.0.0.0
PORT=8000
