# LLM Provider (Groq via LiteLLM)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
LLM_MODEL=groq/llama-3.3-70b-versatile

# Embedding (local sentence-transformers, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=100

# MongoDB
MONGODB_URI=mongodb://localhost:27017/talentmatch

# Qdrant
QDRANT_URL=http://localhost:6333

# Qdrant collection names
QDRANT_COLLECTION_CANDIDATE=candidate_chunks
QDRANT_COLLECTION_JD=jd_chunks

# Server
HOST=0.0.0.0
PORT=8000
